# LancersPulse environment template.
# Copy to .env for local development. NEVER commit a populated .env.
# In the University deployment these are injected from the Kubernetes Secret
# hk-mac-injury-entra-creds and from k8s/deployment.yml.

# --- Core -------------------------------------------------------------------
SECRET_KEY=change-me-to-50-or-more-random-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# --- Storage ----------------------------------------------------------------
# On Kubernetes both live on the PVC mounted at /data, in separate
# subdirectories so a database backup does not sweep up athlete photographs.
# DB_PATH=/data/db/db.sqlite3
# MEDIA_ROOT=/data/media

# --- Reverse proxy ----------------------------------------------------------
# Set True ONLY behind the campus Gateway, which terminates TLS and forwards
# plain HTTP. Without it, SECURE_SSL_REDIRECT causes an infinite redirect loop
# when DEBUG=False. Leave False locally.
BEHIND_PROXY=False

# --- Microsoft Entra SSO ----------------------------------------------------
# Supplied by IT Services. Sign-in is disabled until these are set.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# --- Email ------------------------------------------------------------------
# OFF by default. The deployment has no network egress, and against a blocked
# network send_mail hangs on the socket rather than failing. Do not enable
# without an approved SMTP relay.
NOTIFICATION_EMAIL_ENABLED=False
# EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=LancersPulse <noreply@uwindsor.ca>

# --- Data retention ---------------------------------------------------------
# Agreed with CHPH on 2026-11-25. NOT yet checked against a University records
# retention schedule; health-record retention is often prescribed.
RETENTION_INJURY_RECORD_YEARS=7
RETENTION_INJURY_PHOTO_DAYS=365
RETENTION_SUPPORTING_RECORD_YEARS=7
RETENTION_EMERGENCY_CONTACT_DAYS=0
RETENTION_PENDING_UPLOAD_DAYS=1

# --- Logging ----------------------------------------------------------------
# Audit events are written to stderr as JSON regardless of this value;
# Kubernetes forwards them to the University SIEM.
DJANGO_LOG_LEVEL=INFO
